---
const year = new Date().getFullYear();
---

<footer>
	<div class="footer-inner">
		<p class="copyright">&copy; {year}</p>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 2rem;
		margin-top: 6rem;
	}

	.footer-inner {
		max-width: var(--max-width);
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.copyright {
		font-size: 0.8rem;
		color: var(--text-muted);
	}
</style>
